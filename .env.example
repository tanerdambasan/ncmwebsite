# Server
PORT=3000
BASE_URL=http://localhost:3000

# Admin
ADMIN_KEY=change-this-to-a-long-random-secret
ADMIN_EMAIL=admin@ncmteknoloji.com

# Demo talep bildirimlerinin gideceği adres (boşsa ADMIN_EMAIL kullanılır)
DEMO_NOTIFY_EMAIL=taner.dambasan@gmail.com

# Doğrulama kodu / kurulum jetonu ayarları
VERIFY_CODE_TTL_MINUTES=15
VERIFY_CODE_MAX_ATTEMPTS=5
ONBOARD_TOKEN_TTL_MINUTES=60

# SMTP - E-posta gönderimi için
# Gmail için: host=smtp.gmail.com, port=587, secure=false
# Outlook için: host=smtp.office365.com, port=587, secure=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=NCMSoft <your-email@gmail.com>

# Demo Portal URL
DEMO_URL=http://portal.ncmteknoloji.com

# Backend bağlantısı (Docker: http://ncmsoft-backend:3000, lokal: http://localhost:3000)
BACKEND_INTERNAL_URL=http://ncmsoft-backend:3000

# Demo provision gizli anahtarı (backend/.env'deki DEMO_PROVISION_KEY ile aynı olmalı)
DEMO_PROVISION_KEY=change-this-to-the-same-long-random-secret-as-backend

# Eski admin panel linkleri (?key=...) sadece lokal geliştirmede gerekirse açılabilir.
ALLOW_ADMIN_KEY_QUERY=false

# ── SMS ALTYAPISI ──────────────────────────────────────────────────────────
# SMS_PROVIDER: log (varsayılan, sadece konsola yazar) | netgsm | twilio | http
#
# ÖNERİLEN (Türkiye canlı OTP): netgsm
#   1) netgsm.com.tr'den hesap aç (kayıtta ücretsiz deneme SMS kredisi verir)
#   2) Bir gönderici başlığı (msgheader) tanımlat — OTP/doğrulama kodu İYS'den
#      muaftır ama başlık onayı yine de gerekir (birkaç iş günü sürebilir)
#   3) Aşağıya SMS_USER (abone no), SMS_PASS ve SMS_FROM (onaylı başlık) gir
#   4) `node test-sms.js 5xxxxxxxxx` ile canlı test et
SMS_PROVIDER=log
SMS_FROM=NCMSOFT

# ── netgsm ──
SMS_USER=
SMS_PASS=
# SMS_API_URL boşsa varsayılan kullanılır: https://api.netgsm.com.tr/sms/send/get

# ── twilio (uluslararası / trial) ──
# SMS_PROVIDER=twilio, SMS_FROM=+1..., ayrıca:
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=

# ── http (generic webhook / kendi SMS gateway'in) ──
# SMS_PROVIDER=http → SMS_API_URL'e {to, from, message} JSON POST edilir
SMS_API_URL=
SMS_API_KEY=
